PREFECT_API_URL=http://127.0.0.1:4200/api
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
PHOENIX_PROJECT_NAME=search-query-generation
PHOENIX_DEEP_SEARCH_TASK_GENERATION_PROJECT_NAME=deep-search-task-generation

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
OPENAI_MAX_RETRIES=5
FIREWORKS_ACCOUNT_ID=
TURBOPUFFER_API_KEY=
# TURBOPUFFER_REGION=gcp-us-central1
# TURBOPUFFER_NAMESPACE_PREFIX=ragent

# Durable storage for everything generated under data_pipelines/data/.
# DATA_PIPELINES_GCS_URI=gs://your-bucket/ragent/data-pipelines
# GCS_SERVICE_ACCOUNT=/absolute/path/to/service-account.json

RAGENT_EMBEDDING_SERVICE_URL=http://127.0.0.1:3000
RAGENT_RERANKER_SERVICE_URL=http://127.0.0.1:3001
RAGENT_RETRIEVER_AUTHKEY=replace-with-a-local-random-secret

# Final rubric repair: inherits OPENAI_API_KEY / OPENAI_BASE_URL above.
# Optional independent endpoint overrides:
# RAGENT_REPAIR_API_KEY=
# RAGENT_REPAIR_BASE_URL=https://api.fireworks.ai/inference/v1
# RAGENT_REPAIR_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
# Set the actual combined context limit supported by your chosen endpoint.
# RAGENT_REPAIR_CONTEXT_TOKENS=500000
# RAGENT_REPAIR_MAX_INPUT_TOKENS=500000
# RAGENT_REPAIR_MAX_OUTPUT_TOKENS=8192
# RAGENT_REPAIR_LEDGER_TOKENS=6000
# RAGENT_REPAIR_MAX_CALLS=32
