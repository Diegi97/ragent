# Fireworks training and policy sampling.
FIREWORKS_API_KEY=

# Retrieval tools used by the deep-search environment.
TURBOPUFFER_API_KEY=
# TURBOPUFFER_REGION=gcp-us-central1
# TURBOPUFFER_NAMESPACE_PREFIX=ragent

# Rubric judge at the Prime endpoint configured in configs/environment.toml.
PRIME_API_KEY=
# PRIME_TEAM_ID=

# Optional: private or gated Hugging Face datasets/tokenizers.
# HF_TOKEN=

# Optional W&B logging. Set ENTITY to enable it; no API key means offline logging.
WANDB_API_KEY=
WANDB_ENTITY=
# WANDB_PROJECT=ragent-fireworks-rl
# WANDB_MODE=offline

# Optional model services for dense/hybrid retrieval (unused in BM25 mode).
# RAGENT_EMBEDDING_SERVICE_URL=http://127.0.0.1:3000
# RAGENT_RERANKER_SERVICE_URL=http://127.0.0.1:3001
